# Keep false in public deployments. True only for localhost isolated development.
SYNAPSE_ENABLE_DEMO_APIS=false
# Proxy server-to-server: never expose API keys through NEXT_PUBLIC_ variables.
LATEX_COMPILER_URL=http://compiler:8000
LATEX_COMPILER_TOKEN=replace-with-long-random-token
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
# Public deployment must add authentication and per-user authorization before enabling these routes.
